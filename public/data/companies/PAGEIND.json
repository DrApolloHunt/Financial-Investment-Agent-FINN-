dfOpen.aspx?Pname=d2fd8640-891c-4ccc-9c91-305feb04f2b9.pdf"},{"quarter":"Q4 FY26","kind":"reiterated","quote":"We target to take that up to close to 5% in the next year.","note":"Management reaffirmed the marketing spend target of close to 5%.","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=5f9a5a4c-c6ee-4ce6-a5b0-b60519f0206b.pdf","reported":4},{"quarter":"Q1 FY27","kind":"reiterated","quote":"Otherwise, the intent is to continue operating between a 4 to 5 percentage of the revenue towards marketing.","note":"Management reconfirmed the intent to operate between 4% to 5% of revenue towards marketing.","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=a1bcd17b-4c38-415c-b0fe-06ac3101e5bb.pdf"}],"original_target":{"low":4.0,"high":5.0,"unit":"%"},"horizon_end":"Q4 FY26","actual":{"value":4,"unit":"%","period":"Q4 FY26","ytd":false,"source":"management, Q4 FY26 call","note":"Management reaffirmed the marketing spend target of close to 5%."},"status":"kept","reason":"Q4 FY26: 4% vs target.","revised":null,"contradiction":false,"closed":true,"verdict":"Marketing spend was kept at 4% for Q4 FY26, meeting the target."}],"counts":{"kept":3,"on_track":0,"pending":4,"slipping":0,"missed":0,"dropped":3},"credibility":"Management delivers on core margin and marketing targets, but frequently drops expansion metrics like outlet additions and capex without updates, showing mixed reliability in long-term strategic guidance.","bull":["High capital efficiency is evident with an ROE of 54.3% and ROCE of 64.4% in the latest figures.","Strong cash conversion with operating cash flow at 107% of reported profit over the past five years.","EBITDA margin has steadily widened from 18.6% in FY21 to 22.0% in FY26."],"bear":["Revenue growth has slowed significantly to 3.6% annually over three years compared to 13.1% over five years.","Working-capital days have stretched from 10 days to 26 days over the past five years.","Borrowings increased to INR396 cr from INR1